@article{felicianiFundingLotteriesResearch2024,
  title = {Funding {{Lotteries}} for {{Research Grant Allocation}}: {{An Extended Taxonomy}} and {{Evaluation}} of {{Their Fairness}}},
  shorttitle = {Funding Lotteries for Research Grant Allocation},
  author = {Feliciani, Thomas and Luo, Junwen and Shankar, Kalpana},
  year = 2024,
