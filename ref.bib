  author = {Gigerenzer, Gerd and Allen, Colin and Gaillard, Stefan and Goldstone, Robert L. and Haaf, Julia and Holmes, William R. and Kashima, Yoshihisa and Motz, Benjamin and Musslick, Sebastian and Stefan, Angelika},
