@article{TianJiYuDIDMoXingDeKeJiZhengCeChuangXinNengLiZiZhuXiaoYingShiZhengYanJiuYiJieQingJiJinDiQiuKeXueXiangMuWeiLi2018,
  title = {{{基于DID模型的科技政策创新能力资助效应实证研究}}---以杰青基金地球科学项目为例},
